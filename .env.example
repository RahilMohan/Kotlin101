# Kotlin101 Environment Configuration
# Copy this file to .env and fill in values for your machine.

# --- Java / Kotlin ---
JAVA_HOME=/path/to/jdk-25
KOTLIN_HOME=/path/to/kotlin-2.3.21

# --- Android SDK (required for Projects 6–15) ---
ANDROID_HOME=/Users/$USER/Library/Android/sdk
ANDROID_SDK_ROOT=/Users/$USER/Library/Android/sdk

# --- Wear OS Debugging (optional) ---
WEAR_DEVICE_IP=192.168.1.100
WEAR_DEBUG_PORT=5555

# --- Gradle ---
GRADLE_OPTS=-Xmx2048m -Dfile.encoding=UTF-8

# --- API Keys (optional, used in Projects 7, 9, 10) ---
WEATHER_API_KEY=
CHAT_API_KEY=
MOVIE_API_KEY=
